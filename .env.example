# 仅为配置示例；本地脚本自动在 var/local/config.json 生成独立密钥。
SITE_ADDR=127.0.0.1:8080
SITE_DATABASE_PATH=/absolute/private/path/site.sqlite
SITE_ASSET_DIR=/absolute/private/path/assets
SITE_PUBLIC_ORIGIN=https://localhost:8443
SITE_CSRF_KEY=replace-with-64-hex-characters
SITE_RATE_LIMIT_KEY=replace-with-64-hex-characters
NUXT_API_BASE_URL=http://127.0.0.1:8080
