{
  "name": "personal-website-tools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "24.22.3",
    "pnpm": "12.21.0"
  },
  "scripts": {
    "dev:doctor": "node scripts/dev/services.mjs doctor",
    "dev:prepare": "node scripts/dev/services.mjs prepare",
    "dev:up": "node scripts/dev/services.mjs up",
    "dev:status": "node scripts/dev/services.mjs status",
    "dev:down": "node scripts/dev/services.mjs down",
    "generate": "pnpm --dir ../frontend generate",
    "lint": "eslint scripts/dev scripts/test tests",
    "format:check": "prettier --check scripts/dev/*.mjs scripts/test tests package.json pnpm-workspace.yaml eslint.config.mjs",
    "typecheck": "pnpm --dir ../frontend typecheck",
    "check": "node scripts/dev/quality.mjs check",
    "test": "pnpm test:unit && pnpm test:lifecycle",
    "test:lifecycle": "pnpm build:api && node --test scripts/dev/*.test.mjs",
    "test:integration": "node scripts/test/integration.mjs",
    "test:e2e": "node scripts/test/e2e.mjs",
    "build": "node scripts/dev/quality.mjs build",
    "build:web": "pnpm --dir ../frontend build:web",
    "build:admin": "pnpm --dir ../frontend build:admin",
    "build:api": "node scripts/dev/quality.mjs build-api",
    "install:all": "pnpm install --frozen-lockfile && pnpm --dir ../frontend install --frozen-lockfile",
    "check:workspace": "node scripts/dev/workspace.mjs",
    "test:unit": "node --test scripts/test/*.test.mjs && pnpm --dir ../frontend test && node scripts/dev/quality.mjs go-test",
    "test:lifecycle:run": "node --test scripts/dev/*.test.mjs",
    "verify": "pnpm check && pnpm test:unit && pnpm build && pnpm test:lifecycle:run && pnpm test:acceptance",
    "test:acceptance": "node scripts/test/acceptance.mjs",
    "test:interruption": "pnpm build:api && node scripts/test/interruption.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "globals": "16.5.0"
  }
}
