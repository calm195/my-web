#!/bin/sh
set -eu
# 所有入口从自身位置确定根目录；从其他工作目录调用也使用同一套合同和运行区。
project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_root"
with_tools="$project_root/tools/scripts/dev/with-tools.sh"
command_name=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$command_name" in
  help|-h|--help)
    cat <<'HELP'
用法：./dev <命令>
  install             安装私有工具、冻结依赖、Python 检查环境和 Firefox
  up                  构建 API、准备本地环境并启动同源 HTTPS 服务
  status | down       查看状态或停止本次环境的服务
  doctor | prepare    检查工具或显式准备本地环境
  check | test        检查合同与代码，或执行单元/race/编排故障测试
  build [api|web|admin] 分别构建全部或指定产物
  verify              检查、测试、构建并用一次真实服务启动完成全部验收
  acceptance          用一次真实服务启动完成浏览器与 HTTP 验收
  integration | e2e   单独运行 HTTPS 接口或浏览器验收
  generate            从根 contracts 生成前端类型
  workspace [--locked] 检查子模块及固定提交
  exec <命令...>       使用项目私有工具执行高级命令
HELP
    exit 0 ;;
  install)
    [ "$#" -eq 0 ] || { echo 'install 不接受参数' >&2; exit 2; }
    python3 tools/scripts/dev/bootstrap.py
    sh "$with_tools" pnpm --dir tools install:all
    if [ ! -x var/venv/bin/python ]; then python3 -m venv var/venv; fi
    var/venv/bin/python -m pip install -r tools/scripts/design-requirements.txt
    PLAYWRIGHT_BROWSERS_PATH="$project_root/var/cache/playwright" \
      sh "$with_tools" pnpm --dir tools exec playwright install firefox
    exit 0 ;;
esac

[ -x "$project_root/var/toolchain/node/bin/node" ] || {
  echo '项目私有工具尚未安装，请先执行 ./dev install' >&2; exit 1;
}
run_script() { sh "$with_tools" pnpm --dir "$project_root/tools" "$@"; }
case "$command_name" in
  exec)
    [ "$#" -gt 0 ] || { echo 'exec 需要明确的命令及参数' >&2; exit 2; }
    exec sh "$with_tools" "$@" ;;
  workspace) exec sh "$with_tools" node tools/scripts/dev/workspace.mjs "$@" ;;
  build)
    target=${1:-all}
    [ "$#" -le 1 ] || { echo 'build 只接受一个目标' >&2; exit 2; }
    if [ "$#" -gt 0 ]; then shift; fi
    case "$target" in
      all) script=build ;;
      api|web|admin) script="build:$target" ;;
      *) echo '构建目标必须是 api、web 或 admin' >&2; exit 2 ;;
    esac ;;
  up)
    [ "$#" -eq 0 ] || { echo 'up 不接受参数' >&2; exit 2; }
    # 先显式迁移再启动；保存已有账号和数据，构建失败时不会启动任何进程。
    run_script build:api
    run_script dev:prepare
    exec sh "$with_tools" pnpm --dir "$project_root/tools" dev:up ;;
  doctor|prepare|status|down) script="dev:$command_name" ;;
  check|test|verify|generate) script="$command_name" ;;
  integration|e2e|acceptance)
    [ "$#" -eq 0 ] || { echo "$command_name 不接受参数" >&2; exit 2; }
    run_script build:api
    script="test:$command_name" ;;
  *) echo "未知命令：$command_name；运行 ./dev help 查看用法" >&2; exit 2 ;;
esac
[ "$#" -eq 0 ] || { echo "$command_name 不接受额外参数" >&2; exit 2; }
exec sh "$with_tools" pnpm --dir "$project_root/tools" "$script"
